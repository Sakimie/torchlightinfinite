  "sourceReview": [
    {
      "area": "portable location",
      "status": "reviewed",
      "finding": "Host resolves its executable directory from Environment.ProcessPath and uses EXEdir/data. The working directory does not select data placement. Startup error diagnostics go beside EXE, not into an incomplete data target."
    },
    {
      "area": "no legacy fallback",
      "status": "reviewed",
      "finding": "Unwritable app/data directories stop with a local error; Host and PortableStorage do not switch writes to AppData."
    },
    {
      "area": "legacy migration and original retention",
      "status": "reviewed",
      "finding": "State/calibration/releases/logs are copied into a sibling staging tree, flushed and published by a same-volume Directory.Move. Existing nonempty data is never merged or overwritten. Legacy stable files are not modified or deleted."
    },
    {
      "area": "migration boundaries",
      "status": "reviewed",
      "finding": "Destination/source locks, overlap/link rejection, bounded file counts and sizes, cancellation before publish and temporary cleanup were reviewed. Root unknown files and temporary data are left in legacy storage. A missing legacy .update.lock may be created for synchronization; this is not a zero-write claim about the old directory."
    },
    {
      "area": "launcher compatibility",
      "status": "reviewed",
      "finding": "UpdateService LauncherVersion is 1.1.0 and the existing authenticated launcherMin comparison remains intact. New manifest requires 1.1.0, so old 1.0.0 launchers reject it before installing. New launcher can still authenticate signed 1.0.0 history. The requirement to replace the complete launcher/runtime package is not bypassed."
    },
    {
      "area": "relocation",
      "status": "reviewed",
      "finding": "State stores signed version identities and relative release files; startup recomputes data and version directories from the relocated EXE. Calibration coordinates are copied as user data. The full folder, including the five native sidecars, must move together."
    }
  ],
  "limitations": [
    "No Windows startup, WPF/native-DLL loading, F8 capture, high-DPI or overlay rendering was executed here.",
    "The no-extraction conclusion concerns .NET bundle extraction, supported by actual bundle flags/types and official runtime code. It does not claim that Windows, GPU drivers or other system services never maintain their own caches.",
    "Original stable legacy files are retained; migration may create the legacy synchronization lock. Only the documented stable-data whitelist is migrated.",
    "This review does not rerun the separate console migration suite or make OCR, training-return or global-optimality claims."
  ]
}
